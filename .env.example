# Example mode (default): games are served from pre-generated traces (traces.json).
# No LLM or model download required.
#
# In production, configure an LLM backend to generate fresh games from PDFs:
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_BACKEND=anthropic
# or
# LLM_BACKEND=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:0.6b